# ============================================================
# MOBIEER — Backend / API
# Copie este arquivo para .env e preencha os valores.
# ============================================================

# --- Banco de dados (Prisma / PostgreSQL) -------------------
DATABASE_URL="postgresql://mobieer:mobieer_dev_2026@localhost:5434/mobieer?schema=public"

# --- App / rede --------------------------------------------
PORT=3333
# URLs do frontend liberadas no CORS (separadas por vírgula)
FRONTEND_URLS="http://localhost:5173"
# Base pública da aplicação — usada para montar links em e-mails (convite, redefinição de senha)
APP_URL="http://localhost:5173"

# --- Autenticação do app interno --------------------------
# Obrigatório em produção. Gere um valor aleatório longo e exclusivo.
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="12h"

# --- Autenticação do PORTAL DO CLIENTE --------------------
# Secret SEPARADO do app interno. Se vazio, deriva de JWT_SECRET + ":portal".
PORTAL_JWT_SECRET=""
PORTAL_JWT_EXPIRES_IN="7d"
# Caminho do portal dentro do frontend (usado nos links de convite)
PORTAL_PATH="/portal"

# --- Armazenamento de arquivos (documentos de projeto) ----
# disk     = grava em ./uploads (somente desenvolvimento; efêmero na Vercel)
# supabase = Supabase Storage (recomendado para produção)
STORAGE_DRIVER="disk"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="project-documents"
# Validade (em segundos) das URLs assinadas de download
STORAGE_SIGNED_URL_TTL=120

# --- Envio de e-mail -------------------------------------
# console = apenas imprime o conteúdo no log (desenvolvimento)
# resend  = envia via API da Resend (https://resend.com)
MAIL_DRIVER="console"
MAIL_FROM="MOBIEER <no-reply@mobieer.com.br>"
RESEND_API_KEY=""

# --- Formulário de avaliação (Google Forms) --------------
# URL padrão do formulário de satisfação exibido no portal do cliente.
# Pode ser sobrescrito por projeto (campo feedbackFormUrl).
CLIENT_FEEDBACK_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSdvNCgnIoe9Nq5ao7z3AwFHBOWWbUgkraR63yiCeXQam6VrRQ/viewform"

# ============================================================
# INTEGRAÇÕES EXTERNAS (todas OPCIONAIS)
# Sem credencial cada uma opera em modo fallback:
#  - WhatsApp   -> mensagens só no log
#  - IA         -> cronograma gerado por heurística local
#  - Assinatura -> só a assinatura desenhada no portal
#  - NF-e       -> endpoints respondem "provedor não configurado"
# ============================================================

# --- WhatsApp Business (Meta Cloud API) ------------------
# Crie o app na Meta, verifique um número e gere um token permanente.
WHATSAPP_ENABLED=""                 # vazio = liga sozinho quando TOKEN + PHONE_NUMBER_ID existirem
WHATSAPP_PROVIDER="meta"
WHATSAPP_TOKEN=""                   # System User token (permanente) da Meta
WHATSAPP_PHONE_NUMBER_ID=""         # ID do número (não é o telefone em si)
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="pt_BR"

# --- IA — cronograma de produção -------------------------
# Cliente compatível com a API "chat/completions" da OpenAI.
# OpenAI:   AI_BASE_URL="https://api.openai.com/v1"           AI_MODEL="gpt-4o-mini"
# xAI/Grok: AI_BASE_URL="https://api.x.ai/v1"                 AI_MODEL="grok-2-latest"
AI_ENABLED=""                      # vazio = liga sozinho quando AI_API_KEY existir
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="30000"

# --- Assinatura eletrônica (Clicksign) ------------------
SIGNATURE_ENABLED=""               # vazio = liga sozinho quando SIGNATURE_API_TOKEN existir
SIGNATURE_PROVIDER="clicksign"
SIGNATURE_API_TOKEN=""             # access_token da conta Clicksign
SIGNATURE_BASE_URL="https://app.clicksign.com"   # sandbox: https://sandbox.clicksign.com
SIGNATURE_DELIVERY="email"         # email | whatsapp

# --- NF-e / NFS-e (via provedor homologado) -------------
# Padrão: Focus NF-e. Homologação: NFE_BASE_URL="https://homologacao.focusnfe.com.br"
#         Produção:   NFE_BASE_URL="https://api.focusnfe.com.br"
NFE_ENABLED=""                     # vazio = liga sozinho quando TOKEN + BASE_URL existirem
NFE_PROVIDER="focusnfe"
NFE_API_TOKEN=""
NFE_BASE_URL=""
NFE_ENVIRONMENT="homologacao"      # homologacao | producao

# Promob: não precisa de chave — a importação é por upload do XML/PDF exportado.
