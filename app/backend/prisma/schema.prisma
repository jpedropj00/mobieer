model PostSale {
  id             String         @id @default(cuid())
  status         PostSaleStatus @default(PENDING)
  contactDueAt   DateTime
  contactedAt    DateTime?
  result         String?
  notes          String?        @db.Text
  satisfaction   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  orderId        String?
  order          SalesOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  saleId         String?
  sale           Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responsibleId  String
  responsible    User           @relation(fields: [responsibleId], references: [id])

  @@index([organizationId, status, contactDueAt])
  @@index([clientId])
  @@index([responsibleId])
}

model CommercialHistory {
  id            String                 @id @default(cuid())
  action        String
  fromValue     Json?
  toValue       Json?
  createdAt     DateTime               @default(now())
  clientId      String?
  client        Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          CommercialLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   CommercialOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         CommercialQuote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([quoteId, createdAt])
}

model AgendaEventHistory {
  id        String      @id @default(cuid())
  action    String
  fromValue Json?
  toValue   Json?
  createdAt DateTime    @default(now())
  eventId   String
  event     AgendaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([userId])
}

