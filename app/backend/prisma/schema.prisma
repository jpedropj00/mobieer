// SETTINGS
// ============================================================

model Setting {
  key   String @id
  value String @db.Text
}

// ============================================================
// CLIENT PORTAL / PROJECT DOCUMENTS
// ============================================================

enum ProjectDocumentType {
  MANUAL_GARANTIA
  VISTORIA_CHECKLIST
  CRONOGRAMA
  VISTORIA_FOTOGRAFICA
  CONTRATO
  PROJETO_3D
  OUTRO
}

enum DocumentSignatureStatus {
  NOT_REQUIRED
  PENDING
  SIGNED
}

model DocumentTemplate {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  type             ProjectDocumentType @default(OUTRO)
  description      String?             @db.Text
  storageKey       String
  fileName         String
  mimeType         String
  sizeBytes        Int
  requiresSignature Boolean            @default(false)
  signerRoles      String[] // ex.: ["MOBIEER", "CLIENTE"]
  visibleToClient  Boolean             @default(true)
  active           Boolean             @default(true)
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  documents        ProjectDocument[]

  @@index([organizationId, active])
}

model ProjectDocument {
  id              String              @id @default(cuid())
  organizationId  String
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId      String?
  template        DocumentTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  type            ProjectDocumentType @default(OUTRO)
  title           String
  description     String?             @db.Text
  storageKey      String // caminho no bucket / disco
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksum        String? // sha-256
  visibleToClient Boolean             @default(false)
  requiresSignature Boolean           @default(false)
  signerRoles     String[]
  signatureStatus DocumentSignatureStatus @default(NOT_REQUIRED)
  signatureProvider       String? // ex: "clicksign" quando enviado a um provedor externo
  signatureProviderRef    String? // chave do documento no provedor
  signatureProviderUrl    String? // link de assinatura
  signatureProviderStatus String? // status devolvido pelo provedor
  version         Int                 @default(1)
  replacesId      String?
  replaces        ProjectDocument?    @relation("ProjectDocumentVersions", fields: [replacesId], references: [id], onDelete: SetNull)
  supersededBy    ProjectDocument[]   @relation("ProjectDocumentVersions")
  uploadedById    String?
  uploadedBy      User?               @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  signatures      DocumentSignature[]
  technicalApprovals TechnicalProjectApproval[]
  createdAt       DateTime            @default(now())

  @@index([organizationId, projectId, type])
  @@index([clientId, visibleToClient])
}

model DocumentSignature {
  id                     String          @id @default(cuid())
  documentId             String
  document               ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role                   String // MOBIEER | CLIENTE | TECNICO | ...
  signerName             String
  dataUrl                String          @db.Text // PNG base64 da assinatura desenhada
  signedByUserId         String?
  signedByClientAccountId String?
  ip                     String?
  signedAt               DateTime        @default(now())

  @@unique([documentId, role])
  @@index([documentId])
}

enum ClientAccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

// ============================================================
// RH — COLABORADORES E FÉRIAS
// ============================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum VacationPeriodStatus {
  OPEN
  SCHEDULED
  CONCLUDED
}

enum VacationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  SCHEDULED
  TAKEN
  CANCELLED
}

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registration   String // matrícula (gerada: EMP-0001)
  fullName       String
  role           String? // cargo
  sector         String?
  email          String?
  phone          String?
  admittedAt     DateTime
  terminatedAt   DateTime?
  weeklyHours    Int            @default(44)
  status         EmployeeStatus @default(ACTIVE)
  userId         String?        @unique
  user           User?          @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)

  vacationPeriods  VacationPeriod[]
  vacationRequests VacationRequest[]
  timeEntries      TimeEntry[]
  hourBank         HourBankAdjustment[] @relation("EmployeeHourBank")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, registration])
  @@index([organizationId, status])
}

// ============================================================
// RH — PONTO ELETRÔNICO (visualização / importação)
// Aparelho de referência: KNUP KP-1028 (exporta por pendrive; sem API).
// ============================================================

enum TimeEntryKind {
  IN
  OUT
  BREAK_OUT
  BREAK_IN
}

enum TimeEntrySource {
  DEVICE_IMPORT
  MANUAL
}

model TimeClockDevice {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  model          String   @default("KNUP KP-1028")
  location       String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model TimeEntryImport {
  id             String      @id @default(cuid())
  organizationId String
  fileName       String
  rowsOk         Int         @default(0)
  rowsError      Int         @default(0)
  periodFrom     DateTime?
  periodTo       DateTime?
  importedById   String?
  createdAt      DateTime    @default(now())
  entries        TimeEntry[]

  @@index([organizationId, createdAt])
}

model TimeEntry {
  id             String          @id @default(cuid())
  organizationId String
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp      DateTime
  kind           TimeEntryKind
  source         TimeEntrySource @default(DEVICE_IMPORT)
  importId       String?
  import         TimeEntryImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  note           String?
  createdById    String?
  createdAt      DateTime        @default(now())

  @@unique([employeeId, timestamp])
  @@index([organizationId, timestamp])
  @@index([employeeId, timestamp])
}

model VacationPeriod {
  id              String               @id @default(cuid())
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accrualStart    DateTime // início do período aquisitivo
  accrualEnd      DateTime // fim do período aquisitivo
  concessionLimit DateTime // limite para gozar (fim do período concessivo)
  daysEntitled    Int                  @default(30)
  daysTaken       Int                  @default(0)
  status          VacationPeriodStatus @default(OPEN)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  requests        VacationRequest[]

  @@index([employeeId, status])
  @@index([concessionLimit])
}

model VacationRequest {
  id          String                @id @default(cuid())
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodId    String?
  period      VacationPeriod?       @relation(fields: [periodId], references: [id], onDelete: SetNull)
  startDate   DateTime
  endDate     DateTime
  days        Int
  sellDays    Int                   @default(0) // abono pecuniário
  status      VacationRequestStatus @default(REQUESTED)
  note        String?               @db.Text
  decidedById String?
  decidedBy   User?                 @relation("VacationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([employeeId, status])
  @@index([status, startDate])
}

// ============================================================
// FINANCEIRO — LANÇAMENTOS (receitas / despesas)
// Inspirado no módulo "financeiro" do econofinance, adaptado ao MOBIEER.
// ============================================================

enum FinanceType {
  RECEITA
  DESPESA
}

enum FinanceStatus {
  PENDENTE
  PAGO
}

model FinanceTransaction {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           FinanceType
  category       String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime // competência / lançamento
  dueDate        DateTime? // vencimento (contas a pagar/receber)
  description    String?       @db.Text
  status         FinanceStatus @default(PENDENTE)
  paidAt         DateTime?
  method         String? // forma de pagamento

  // parcelamento (compras parceladas)
  installmentGroup  String? // id do grupo; parcelas do mesmo grupo compartilham
  installmentNumber Int? // 1..N
  installmentTotal  Int? // N

  // origem automática (contrato/oportunidade ganha)
  originOpportunityId String?
  originOpportunity   CommercialOpportunity? @relation(fields: [originOpportunityId], references: [id], onDelete: SetNull)

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cardExpenseId String?  @unique
  cardExpense   CardExpense? @relation(fields: [cardExpenseId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("FinanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, type, status])
  @@index([organizationId, date])
  @@index([installmentGroup])
  @@index([projectId])
  @@index([supplierId])
  @@index([clientId])
}

// ---- Cartão de crédito (análise de gastos + fatura) ----
model CreditCard {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  lastDigits     String?
  closingDay     Int?
  dueDay         Int?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  statements     CardStatement[]

  @@index([organizationId, active])
}

model CardStatement {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cardId         String
  card           CreditCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  referenceMonth String // YYYY-MM
  total          Decimal       @default(0) @db.Decimal(14, 2)
  fileKey        String? // PDF da fatura no storage
  importedById   String?
  createdAt      DateTime      @default(now())
  expenses       CardExpense[]

  @@unique([cardId, referenceMonth])
  @@index([organizationId, referenceMonth])
}

model CardExpense {
  id          String         @id @default(cuid())
  statementId String
  statement   CardStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  description String
  category    String // Uber, Mercado, Combustível, Software, ...
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime
  installment String? // "2/12"
  transaction FinanceTransaction?

  @@index([statementId])
  @@index([category])
}

// Base de regras fiscais configuráveis (econofinance tax_rules).
// "As alíquotas usadas no desenvolvimento devem ser tratadas como dados
// configuráveis; produção exige regras oficiais e vigentes."
model TaxRule {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regimeTributario   RegimeTributario
  tipoImposto        TipoImposto
  cnae               String?
  uf                 String?
  aliquota           Decimal          @db.Decimal(6, 4) // fração: 0.0600 = 6%
  reducaoBase        Decimal?         @db.Decimal(6, 4) // presunção (base = faturamento * reducaoBase)
  faixaFaturamentoMin Decimal?        @db.Decimal(14, 2)
  faixaFaturamentoMax Decimal?        @db.Decimal(14, 2)
  descricao          String?
  ativo              Boolean          @default(true)
  vigenciaInicio     DateTime         @default(now())
  vigenciaFim        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([organizationId, regimeTributario, tipoImposto, ativo])
}

model ClientAccount {
  id           String              @id @default(cuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  email        String              @unique
  passwordHash String?
  status       ClientAccountStatus @default(INVITED)
  inviteToken  String?             @unique
  inviteExpiry DateTime?
  resetToken   String?             @unique
  resetTokenExpiry DateTime?
  lastLogin    DateTime?
  createdById  String?
  createdBy    User?               @relation("ClientAccountInviter", fields: [createdById], references: [id], onDelete: SetNull)
  openedAssistances AssistanceTicket[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([clientId])
}

// ============================================================
// FASE 2 — JORNADA DO CLIENTE
// Ficha de eletrodomésticos (preenchida pelo cliente no portal)
// ============================================================

enum ApplianceSheetStatus {
  DRAFT // criada; cliente ainda preenchendo
  SUBMITTED // cliente enviou para a Mobieer
  REVIEWED // projetista conferiu
}

model ApplianceSheet {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String               @unique
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         ApplianceSheetStatus @default(DRAFT)
  projetista     String? // nome do projetista (campo 1 da ficha)
  ambientes      String? // "Ambientes do projeto" (texto livre)
  notes          String?              @db.Text // seção 6: observações / instalações especiais
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                @relation("ApplianceSheetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          ApplianceItem[]

  @@index([organizationId])
}

model ApplianceItem {
  id           String         @id @default(cuid())
  sheetId      String
  sheet        ApplianceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  category     String // COZINHA | GOURMET | LAVANDERIA | OUTROS
  name         String // "Geladeira / refrigerador"
  owned        Boolean        @default(false) // já possui?
  willBuy      Boolean        @default(false) // vai comprar?
  brandModel   String?
  widthCm      Decimal?       @db.Decimal(6, 1)
  heightCm     Decimal?       @db.Decimal(6, 1)
  depthCm      Decimal?       @db.Decimal(6, 1)
  referenceUrl String? // link/referência do modelo, quando for comprar
  notes        String?
  custom       Boolean        @default(false) // linha "Outros" adicionada manualmente
  position     Int            @default(0)

  @@index([sheetId])
}

// ============================================================
// FASE 2 — Agendamento da medição + prazo do projeto técnico
// Cliente solicita a medição pelo portal -> equipe confirma data e técnico
// -> técnico registra a conclusão -> dispara o prazo de 12 dias do projeto.
// ============================================================

enum MeasurementStatus {
  REQUESTED // cliente solicitou; aguardando a equipe confirmar
  SCHEDULED // data e técnico definidos
  DONE // medição concluída (dispara o prazo do projeto técnico)
  CANCELLED
}

model MeasurementVisit {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           MeasurementStatus @default(REQUESTED)
  preferredDates   String[] // datas propostas pelo cliente (ISO yyyy-mm-dd)
  preferredPeriod  String? // MANHA | TARDE | QUALQUER
  clientNotes      String?
  scheduledAt      DateTime? // data/hora confirmada pela equipe
  technicianId     String?
  technician       User?             @relation("MeasurementTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  teamNotes        String?
  doneAt           DateTime?
  techProjectDueAt DateTime? // doneAt + 12 dias (prazo do projeto técnico)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([projectId])
}

// ============================================================
// FASE 2 — Aprovação do projeto técnico
// Equipe publica o projeto técnico -> cliente revisa e aprova (assina o
// termo no portal) -> a partir daí o portal exibe o aviso de que
// alterações podem gerar custo adicional e novo prazo.
// ============================================================

enum TechApprovalStatus {
  DRAFT // equipe preparando; cliente não vê
  IN_REVIEW // publicado; aguardando o cliente
  APPROVED // cliente aprovou (assinou o termo)
  CHANGES_REQUESTED // cliente pediu ajustes
}

model TechnicalProjectApproval {
  id                      String             @id @default(cuid())
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId               String             @unique
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status                  TechApprovalStatus @default(DRAFT)
  documentId              String? // ProjectDocument do projeto técnico (3D/PDF) que o cliente revisa
  document                ProjectDocument?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  termText                String?            @db.Text // termo de aprovação exibido ao cliente
  publishedAt             DateTime?
  publishedById           String?
  publishedBy             User?              @relation("TechApprovalPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  approvedAt              DateTime?
  approvedByName          String?
  signatureDataUrl        String?            @db.Text // assinatura desenhada pelo cliente (data URL PNG)
  signedByClientAccountId String?
  clientComment           String?            @db.Text // quando o cliente pede mudanças
  reviewRound             Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([organizationId, status])
}

// ============================================================
// FASE 2 — Esteira de produção
// Depois que o cliente aprova o projeto técnico, o pedido entra na
// esteira: liberado -> em produção -> pré-montagem -> em entrega ->
// entregue. A equipe avança as etapas; o cliente acompanha pelo portal.
// ============================================================

enum ProductionStage {
  RELEASED // liberado para produção (projeto técnico aprovado)
  IN_PRODUCTION // em produção na fábrica
  PRE_ASSEMBLY // pré-montagem / conferência dos módulos
  OUT_FOR_DELIVERY // em rota de entrega e montagem
  DELIVERED // entregue e montado
}

model ProductionOrder {
  id                  String                 @id @default(cuid())
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId           String                 @unique
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage               ProductionStage        @default(RELEASED)
  releasedAt          DateTime? // entrou na esteira (projeto técnico aprovado)
  productionStartedAt DateTime?
  preAssemblyAt       DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime? // previsão de entrega informada pela equipe
  notes               String?                @db.Text
  scheduleJson        Json? // cronograma gerado (etapas + datas + observações)
  scheduleSource      String? // AI | HEURISTIC
  scheduleGeneratedAt DateTime?
  cutPlanImportId     String? // PromobImport marcado como o plano de corte oficial do pedido
  cutPlanImport       PromobImport?          @relation("OrderCutPlan", fields: [cutPlanImportId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  events              ProductionStageEvent[]
  items               ProductionItem[]
  requisitions        Requisition[]

  @@index([organizationId, stage])
}

model ProductionStageEvent {
  id          String          @id @default(cuid())
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage       ProductionStage
  note        String?
  createdAt   DateTime        @default(now())
  createdById String?
  createdBy   User?           @relation("ProductionStageEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ============================================================
// INTEGRAÇÕES EXTERNAS — NF-e e importação do Promob
// Ambos ficam ociosos até haver provedor/arquivo; nenhum dado é
// enviado à SEFAZ sem NFE_* configurado.
// ============================================================

enum FiscalInvoiceStatus {
  DRAFT // rascunho no nosso lado
  QUEUED // enviado ao provedor, aguardando processamento
  PROCESSING // provedor processando junto à SEFAZ
  ISSUED // autorizada
  REJECTED // rejeitada pela SEFAZ
  CANCELLED // cancelada após emissão
  ERROR // falha de comunicação / configuração
}

model FiscalInvoice {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  kind           String              @default("NFE") // NFE | NFSE
  status         FiscalInvoiceStatus @default(DRAFT)
  ref            String              @unique // referência idempotente enviada ao provedor
  provider       String? // ex: focusnfe
  providerRef    String? // chave de acesso / id no provedor
  number         String?
  series         String?
  amount         Decimal             @db.Decimal(12, 2)
  description    String?             @db.Text
  payloadJson    Json? // corpo enviado ao provedor
  resultJson     Json? // última resposta do provedor
  xmlKey         String? // storage key do XML autorizado
  pdfKey         String? // storage key do DANFE/PDF
  errorMessage   String?             @db.Text
  issuedAt       DateTime?
  cancelledAt    DateTime?
  createdById    String?
  createdBy      User?               @relation("FiscalInvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([projectId])
}

model PromobImport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  format         String       @default("OTHER") // XML | PDF | OTHER
  status         String       @default("UPLOADED") // UPLOADED | PARSED | PARSE_FAILED
  itemCount      Int          @default(0)
  parsedJson     Json? // itens/ambientes extraídos (best-effort)
  notes          String?      @db.Text
  createdById    String?
  createdBy      User?        @relation("PromobImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  generatedItems ProductionItem[]
  cutPlanForOrders ProductionOrder[] @relation("OrderCutPlan")

  @@index([organizationId])
  @@index([projectId])
}

// ============================================================
// FASE 3 — Produção (chão de fábrica)
// A ProductionOrder (Fase 2) rastreia o pedido em nível macro. Aqui os
// módulos/peças de cada pedido percorrem os setores da fábrica com
// apontamento por operador: corte -> fita de borda -> furação ->
// pré-montagem -> embalagem -> expedição.
// ============================================================

enum ProductionItemStatus {
  PENDING // ainda não entrou na fábrica
  IN_PROGRESS // em algum setor
  DONE // passou por todos os setores
  CANCELLED
}

enum ProductionSector {
  CORTE
  FITA_BORDA
  FURACAO
  PRE_MONTAGEM
  EMBALAGEM
  EXPEDICAO
}

model ProductionItem {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ambiente       String?
  descricao      String
  referencia     String? // referência do Promob, quando veio de um import
  quantidade     Int                  @default(1)
  material       String?
  status         ProductionItemStatus @default(PENDING)
  sector         ProductionSector? // setor atual (null se PENDING/DONE/CANCELLED)
  sourceImportId String?
  sourceImport   PromobImport?        @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  position       Int                  @default(0)
  notes          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  events         ProductionItemEvent[]
  timeLogs       ProductionTimeLog[]

  @@index([organizationId, status, sector])
  @@index([orderId])
}

model ProductionItemEvent {
  id          String            @id @default(cuid())
  itemId      String
  item        ProductionItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sector      ProductionSector? // setor concluído/afetado (null em criação/cancelamento)
  action      String // ENTER | COMPLETE | JUMP | REOPEN | CANCEL | NOTE
  note        String?
  createdById String?
  createdBy   User?             @relation("ProductionItemEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([itemId])
}

// ============================================================
// FASE 4 — Itens da Jessica
// ============================================================

// 4.1 — Foto do cliente na assistência
model AssistanceAttachment {
  id                        String           @id @default(cuid())
  ticketId                  String
  ticket                    AssistanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  storageKey                String
  fileName                  String
  mimeType                  String
  sizeBytes                 Int
  uploadedByClientAccountId String? // quando enviado pelo cliente no portal
  uploadedByUserId          String? // quando enviado pela equipe
  uploadedByLabel           String? // rótulo pronto para exibir ("Cliente", nome do usuário)
  createdAt                 DateTime         @default(now())

  @@index([ticketId])
}

// 4.4 — Registro de atividade em texto livre (flag no model Activity, sem tabela nova)

// 4.2 — Bloco de notas + planner semanal (pessoal, por usuário)
model WorkspaceNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("WorkspaceNoteOwner", fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  body           String       @db.Text
  color          String? // rótulo de cor opcional
  pinned         Boolean      @default(false)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, pinned, position])
}

model PlannerItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("PlannerItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  weekOf         DateTime     @db.Date // segunda-feira da semana
  weekday        Int // 0=segunda ... 6=domingo
  text           String
  done           Boolean      @default(false)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, weekOf])
}

// 4.3 — Banco de horas: ajustes manuais que somam/abatem do saldo calculado do ponto
enum HourBankKind {
  ADJUSTMENT // ajuste manual (correção)
  COMPENSATION // folga/compensação (abate saldo)
  PAYOUT // pagamento de horas extras (abate saldo)
}

model HourBankAdjustment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation("EmployeeHourBank", fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  minutes        Int // positivo credita, negativo debita
  kind           HourBankKind @default(ADJUSTMENT)
  reason         String?
  createdById    String?
  createdBy      User?        @relation("HourBankAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([employeeId, date])
}

// ============================================================
// FASE 3.4 — Apontamento de horas na produção
// Cada item registra o tempo trabalhado por setor e por operador.
// Serve para custo/produtividade; NÃO alimenta o banco de horas do ponto
// (que é baseado nas marcações do relógio) para evitar dupla contagem.
// ============================================================

model ProductionTimeLog {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           ProductionItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sector         ProductionSector
  userId         String
  user           User             @relation("ProductionTimeLogOperator", fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime
  endedAt        DateTime? // null enquanto o cronômetro está rodando
  minutes        Int? // preenchido ao parar (ou na entrada manual)
  manual         Boolean          @default(false)
  note           String?
  createdAt      DateTime         @default(now())

  @@index([itemId])
  @@index([organizationId, startedAt])
  @@index([userId, endedAt])
}
