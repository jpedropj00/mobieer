// Gestium - Plataforma modular de gestão empresarial
// provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH / USERS / RBAC
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  password         String
  position         String?
  sector           String?
  status           UserStatus @default(ACTIVE)
  imageUrl         String?
  lastLogin        DateTime?
  resetToken       String?    @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  movements         StockMovement[]    @relation("MovementResponsible")
  createdReqs       Requisition[]      @relation("RequisitionCreator")
  approvedReqs      Requisition[]      @relation("RequisitionApprover")
  responsibleReqs   Requisition[]      @relation("RequisitionResponsible")
  cuttingReqs       Requisition[]      @relation("RequisitionCutter")
  inspectedReqs     Requisition[]      @relation("RequisitionInspector")
  requisitionEvents RequisitionHistory[]
  inventories       Inventory[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  stockReservations StockReservation[]

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMIN | MANAGER | WAREHOUSE | REQUESTER | VIEWER
  label       String
  description String?
  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
}

model Permission {
  id     String           @id @default(cuid())
  code   String           @unique // e.g. "products.create"
  label  String
  module String
  roles  RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================================
// CATALOG
// ============================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum Unit {
  UNIT // Unidade
  BOX // Caixa
  PACKAGE // Pacote
  METER // Metro
  LITER // Litro
  KILO // Quilo
  ROLL // Rolo
  PAIR // Par
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  products    Product[]
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  @@index([parentId])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  cnpj      String?         @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  status    SupplierStatus  @default(ACTIVE)
  createdAt DateTime        @default(now())
  products  Product[]
  movements StockMovement[]
}

model Warehouse {
  id                   String                  @id @default(cuid())
  name                 String
  code                 String                  @unique
  address              String?
  createdAt            DateTime                @default(now())
  products             Product[]
  balances             ProductWarehouseStock[]
  originMovements      StockMovement[]         @relation("MovementOriginWarehouse")
  destinationMovements StockMovement[]         @relation("MovementDestinationWarehouse")
  reservations         StockReservation[]
}

model Product {
  id            String        @id @default(cuid())
  name          String
  code          String        @unique // MAT-00001
  sku           String?       @unique
  barcode       String?       @unique
  qrCode        String?       @unique
  description   String?
  unit          Unit          @default(UNIT)
  stock         Int           @default(0)
  reservedStock Int           @default(0)
  minStock      Int           @default(0)
  maxStock      Int?
  unitValue     Decimal?      @db.Decimal(12, 2)
  imageUrl      String?
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  corridor    String? // Corredor
  shelf       String? // Prateleira
  position    String? // Posição

  movements        StockMovement[]
  inventoryItems   InventoryItem[]
  requisitionItems RequisitionItem[]
  notifications    Notification[]
  warehouseStocks  ProductWarehouseStock[]
  reservations     StockReservation[]

  @@index([name])
  @@index([categoryId])
  @@index([barcode])
  @@index([qrCode])
}

// ============================================================
// STOCK
// ============================================================

enum MovementType {
  ENTRY
  EXIT
  ADJUST
  TRANSFER
  RESERVE
  RELEASE
  RETURN
  LOSS
  DAMAGE
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  unitValue Decimal?     @db.Decimal(12, 2)
  date      DateTime     @default(now())
  note      String?

  // ENTRY specific
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String? // Nota fiscal
  batch         String? // Lote

  // EXIT specific
  requesterName String?
  sector        String?
  destination   String?
  reason        String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  responsibleId String?
  responsible   User?   @relation("MovementResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  requisitionId   String?
  requisition     Requisition?   @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  originWarehouseId      String?
  originWarehouse        Warehouse?        @relation("MovementOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?        @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  reservationId          String?
  reservation            StockReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  operationCode          String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([date])
  @@index([type])
}

model ProductWarehouseStock {
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([warehouseId])
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

model StockReservation {
  id          String            @id @default(cuid())
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  note        String?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id])
  requisitionId String?
  requisition Requisition? @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  requisitionItemId String?
  requisitionItem RequisitionItem? @relation(fields: [requisitionItemId], references: [id], onDelete: Cascade)
  movements   StockMovement[]

  @@index([productId, status])
  @@index([requesterId])
  @@index([requisitionId, status])
  @@index([requisitionItemId, status])
}

// ============================================================
// INVENTORY
// ============================================================

enum InventoryStatus {
  OPEN
  IN_PROGRESS
  CONCLUDED
  CANCELLED
}

enum InventoryItemStatus {
  PENDING
  COUNTED
  ADJUSTED
}

model Inventory {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      InventoryStatus @default(OPEN)
  startedById String
  startedBy   User            @relation(fields: [startedById], references: [id])
  concludedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]
}

model InventoryItem {
  id          String              @id @default(cuid())
  expectedQty Int
  countedQty  Int?
  difference  Int?
  status      InventoryItemStatus @default(PENDING)

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  @@unique([inventoryId, productId])
}

// ============================================================
// REQUISITIONS
// ============================================================

enum RequisitionStatus {
  DRAFT
  REQUESTED
  IN_REVIEW
  WAITING_MATERIAL
  RELEASED
  IN_CUTTING
  INSPECTION
  COMPLETED
  CANCELLED
}

enum RequisitionItemStatus {
  PENDING
  CUTTING
  CUT
  INSPECTED
}

enum RequisitionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InspectionResult {
  APPROVED
  NEEDS_CORRECTION
}

model Requisition {
  id          String            @id @default(cuid())
  number      String            @unique // REQ-00001
  sector      String?
  destination String?
  status      RequisitionStatus @default(DRAFT)
  priority    RequisitionPriority @default(NORMAL)
  note        String?
  clientName  String?
  projectReference String?
  neededAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  submittedAt DateTime?
  approvedAt  DateTime?
  cuttingStartedAt DateTime?
  inspectedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  inspectionResult InspectionResult?
  inspectionNote String?

  requesterId String
  requester   User   @relation("RequisitionCreator", fields: [requesterId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  responsibleId String?
  responsible User? @relation("RequisitionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  cutterId String?
  cutter User? @relation("RequisitionCutter", fields: [cutterId], references: [id], onDelete: SetNull)

  inspectorId String?
  inspector User? @relation("RequisitionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)

  items        RequisitionItem[]
  movements    StockMovement[]
  reservations StockReservation[]
  history      RequisitionHistory[]
  attachments  RequisitionAttachment[]

  @@index([status])
  @@index([priority])
  @@index([neededAt])
  @@index([requesterId])
  @@index([responsibleId])
  @@index([cutterId])
  @@index([inspectorId])
}

model RequisitionItem {
  id       String                @id @default(cuid())
  quantity Int
  status   RequisitionItemStatus @default(PENDING)
  description String
  material String?
  thickness Decimal? @db.Decimal(10, 2)
  length Decimal? @db.Decimal(10, 2)
  width Decimal? @db.Decimal(10, 2)
  unit Unit @default(UNIT)
  edgeFinish String?
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reservations StockReservation[]

  @@index([requisitionId])
  @@index([productId])
}

model RequisitionHistory {
  id String @id @default(cuid())
  action String
  fromValue Json?
  toValue Json?
  note String?
  createdAt DateTime @default(now())
  requisitionId String
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requisitionId, createdAt])
  @@index([userId])
}

model RequisitionAttachment {
  id String @id @default(cuid())
  name String
  url String
  mimeType String?
  size Int?
  createdAt DateTime @default(now())
  requisitionId String
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

// ============================================================
// NOTIFICATIONS / AUDIT
// ============================================================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  NEW_REQUISITION
  REQUISITION_APPROVED
  REQUISITION_REFUSED
  INVENTORY_PENDING
  MOVEMENT
  INFO
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // LOGIN, LOGOUT, PRODUCT_CREATED, STOCK_ENTRY, ...
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  key   String @id
  value String @db.Text
}
